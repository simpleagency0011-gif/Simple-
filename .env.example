# ==============================================================================
# SIMPLE Platform Environment Variables Template
# Copy to .env.local for local development. Set in Vercel Project Settings for production.
# NEVER commit .env or .env.local with real values to git!
# ==============================================================================

# 1. JWT & Cryptographic Signing (Minimum 256-bit / 32-character random string)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_secret_in_production
JWT_EXPIRATION_SECONDS=3600

# 2. Rate Limiting Thresholds (Configurable)
AUTH_LIMIT_WINDOW_MS=900000          # 15 minutes
AUTH_MAX_ATTEMPTS=5                 # Max failed attempts before exponential backoff
PUBLIC_LIMIT_WINDOW_MS=600000       # 10 minutes
PUBLIC_MAX_REQUESTS=25              # Public inquiry/booking endpoint limit per IP
AUTHENTICATED_LIMIT_WINDOW_MS=60000 # 1 minute
AUTHENTICATED_MAX_REQUESTS=120      # Authenticated user limit per minute

# 3. Email & Notification Credentials (Server-Side Only)
NOTIFICATION_OWNER_EMAIL=simple.agency0011@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# 4. WhatsApp Business & Webhooks
WHATSAPP_OWNER_PHONE=919407928737
WEBHOOK_SIGNING_SECRET=replace_with_webhook_hmac_secret

# 5. Database Connection (PostgreSQL with RLS)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
